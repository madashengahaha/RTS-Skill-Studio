        {"kind": "hasIntent", "intent": "PeriodicDamage"},
        {"kind": "paramEquals", "path": "AddEffectIntent.PeriodicDamage.durationMs", "equals": 3000},
        {"kind": "paramEquals", "path": "AddEffectIntent.PeriodicDamage.intervalMs", "equals": 1000},
        {"kind": "paramEquals", "path": "AddEffectIntent.PeriodicDamage.fixedDamage", "equals": 80}
