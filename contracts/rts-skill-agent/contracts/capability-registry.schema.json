{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madashengahaha/RTS-Skill-Studio/contracts/capability-registry.schema.json",
  "title": "SkillCapabilityRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryVersion",
    "source",
    "entities",
    "planOperations",
    "readOnlyTools",
    "readOnlyToolContracts",
    "executionProjection",
    "nestedTypes",
    "fieldSemantics",
    "valueSources",
    "similarityScoring",
    "skillGraphSchema",
    "entityFields",
    "intents",
    "effects",
    "conditions",
    "damageStages",
    "enums",
    "enumReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 0
    },
    "registryVersion": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroAuthoringSchemaVersion", "sha256"],
      "properties": {
        "heroAuthoringSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourcePath": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "string"
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "planOperations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "readOnlyTools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "readOnlyToolContracts": {
      "type": "object"
    },
    "executionProjection": {
      "$ref": "#/$defs/ExecutionProjection"
    },
    "nestedTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NestedType"
      }
    },
    "fieldSemantics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FieldSemantics"
      }
    },
    "valueSources": {
      "type": "array",
      "items": {
        "enum": ["ModelProposed", "UserEdited", "Default"]
      },
      "uniqueItems": true
    },
    "similarityScoring": {
      "$ref": "#/$defs/SimilarityScoring"
    },
    "skillGraphSchema": {
      "type": "object"
    },
    "entityFields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntityField"
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Intent"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      }
    },
    "damageStages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CodeType"
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnumDefinition"
      }
    },
    "enumReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "namespace", "kind", "identity", "shared", "role"],
      "properties": {
        "key": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "kind": {
          "enum": ["Table", "Virtual", "Code"]
        },
        "identity": {
          "type": "string"
        },
        "shared": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "EntityField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "semanticName": {
          "type": "string",
          "minLength": 1,
          "description": "Stable Plan-facing field name resolved by the compiler."
        },
        "kind": {
          "enum": [
            "Text",
            "Integer",
            "Boolean",
            "Enum",
            "Reference",
            "List",
            "Map",
            "DelimitedList"
          ]
        },
        "rawType": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "enumName": {
          "type": "string",
          "minLength": 1
        },
        "referenceTarget": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "conversionStatus": {
          "$ref": "#/$defs/ConversionStatus"
        },
        "conversionEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "harmful"],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "harmful": {
          "type": ["boolean", "null"]
        }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "legacyValue",
        "label",
        "minParameterCount",
        "maxParameterCount",
        "parameters",
        "semantic"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "legacyValue": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": ["string", "null"]
        },
        "warning": {
          "type": ["string", "null"]
        },
        "minParameterCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxParameterCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "semantic": {
          "$ref": "#/$defs/Semantic"
        }
      }
    },
    "Parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "key",
        "label",
        "kind",
        "required",
        "repeating",
        "repeatStep"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": ["string", "null"]
        },
        "kind": {
          "enum": ["Reference", "Enum", "ScaledInteger", "Integer", "Boolean", "String"]
        },
        "required": {
          "type": "boolean"
        },
        "referenceTarget": {
          "type": ["string", "null"]
        },
        "enumName": {
          "type": ["string", "null"]
        },
        "scale": {
          "type": ["integer", "null"]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "conversionStatus": {
          "$ref": "#/$defs/ConversionStatus"
        },
        "conversionEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "repeating": {
          "type": "boolean"
        },
        "repeatStep": {
          "type": "integer",
          "minimum": 0
        },
        "allowsMultipleEnumValues": {
          "type": "boolean",
          "default": false
        },
        "executionProjection": {
          "enum": ["Subtree", "Node", "Hidden"]
        },
        "defaultValue": true
      }
    },
    "ExecutionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultParameterProjection",
        "defaultEdgeProjection",
        "parameterRules",
        "edgeRules"
      ],
      "properties": {
        "defaultParameterProjection": {
          "enum": ["Subtree", "Node", "Hidden"]
        },
        "defaultEdgeProjection": {
          "enum": ["Subtree", "Node", "Hidden"]
        },
        "parameterRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExecutionRule"
          }
        },
        "edgeRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExecutionRule"
          }
        }
      }
    },
    "ExecutionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection"],
      "properties": {
        "category": {
          "enum": ["effect", "condition"]
        },
        "actionKey": {
          "type": "string"
        },
        "parameterKey": {
          "type": "string"
        },
        "referenceTarget": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sourceField": {
          "type": "string"
        },
        "projection": {
          "enum": ["Subtree", "Node", "Hidden"]
        }
      }
    },
    "NestedType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "description",
        "encoding",
        "resolution",
        "fields"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "$ref": "#/$defs/NestedTypeEncoding"
        },
        "resolution": {
          "$ref": "#/$defs/NestedTypeResolution"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NestedTypeField"
          }
        }
      }
    },
    "NestedTypeResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "propIdZero", "propIdNonZero"],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "propIdZero": {
          "type": "string",
          "minLength": 1
        },
        "propIdNonZero": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "NestedTypeEncoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "separator", "fields"],
      "properties": {
        "kind": {
          "enum": ["Delimited"]
        },
        "separator": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "NestedTypeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "kind"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "enumName": {
          "type": ["string", "null"]
        },
        "scale": {
          "type": ["integer", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    },
    "FieldSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "description", "indexRoles"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "elementType": {
          "type": ["string", "null"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "indexRoles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldIndexRole"
          }
        }
      }
    },
    "FieldIndexRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "role", "description"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intents", "mechanism", "tags"],
      "properties": {
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "mechanism": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "SimilarityScoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "skillWeights"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "skillWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intents", "mechanisms", "tags", "references"],
          "properties": {
            "intents": {
              "type": "number",
              "minimum": 0
            },
            "mechanisms": {
              "type": "number",
              "minimum": 0
            },
            "tags": {
              "type": "number",
              "minimum": 0
            },
            "references": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "EnumDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "flags", "comment", "values"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "boolean"
        },
        "comment": {
          "type": ["string", "null"]
        },
        "sourceKind": {
          "enum": [
            "BuiltinXml",
            "UnityGeneratedEnum",
            "ParameterConvention"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EnumValue"
          }
        }
      }
    },
    "EnumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "alias", "comment"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer"
        },
        "alias": {
          "type": "string"
        },
        "comment": {
          "type": ["string", "null"]
        }
      }
    },
    "CodeType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "legacyValue", "label"],
      "properties": {
        "key": {
          "type": "string"
        },
        "legacyValue": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "ConversionStatus": {
      "enum": [
        "WorkbookRoundTrip",
        "RuntimeCodeVerified",
        "ConfigDeclared",
        "Unverified"
      ]
    }
  }
}
