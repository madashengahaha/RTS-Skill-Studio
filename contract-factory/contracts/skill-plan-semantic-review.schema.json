{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillPlanSemanticReview v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [0] },
    "requirements": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "dimension", "sourceQuote", "requirement", "status", "planPointers", "evidencePointers", "reason"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "dimension": { "enum": ["Behavior", "Emission", "Delivery", "Targets", "Selection", "Timing", "Values", "Lifecycle", "Presentation", "Other"] },
          "sourceQuote": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["Covered", "Missing", "Uncertain"] },
          "planPointers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^/operations/" } },
          "evidencePointers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^/[0-9]+/" } },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
