{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madashengahaha/RTS-Skill-Studio/contracts/workbook-patch.schema.json",
  "title": "WorkbookPatch",
  "description": "Immutable deterministic compiler output. Models, users, and validators must not edit a compiled Patch in place.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "patchId",
    "sourcePlanHash",
    "base",
    "commands",
    "fieldChanges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 0
    },
    "patchId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the canonical Patch JSON with patchId omitted."
    },
    "sourcePlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "revision",
        "sourceHash",
        "capabilityRegistryVersion",
        "defaultValueContractVersion",
        "defaultMechanismContractVersion"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the deterministic source data root inventory and file bytes."
        },
        "capabilityRegistryVersion": {
          "type": "string",
          "minLength": 1
        },
        "defaultValueContractVersion": {
          "type": "string",
          "minLength": 1
        },
        "defaultMechanismContractVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Allocation"
      },
      "default": []
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Command"
      }
    },
    "fieldChanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FieldChange"
      }
    }
  },
  "$defs": {
    "Allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "localKey", "id", "kind"],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "localKey": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "groupKey": {
          "type": "integer"
        },
        "kind": {
          "enum": ["Id", "GroupId", "MemberId"]
        }
      }
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operationId",
        "kind",
        "target",
        "arguments"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "operationId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "CreateNode",
            "CreateGroup",
            "CreateGroupMember",
            "UpdateNode",
            "LinkExisting",
            "Unlink",
            "DeleteOwnedMember",
            "DeleteExclusiveBranch",
            "ReorderGroupMembers"
          ]
        },
        "target": {
          "$ref": "#/$defs/AssetIdentity"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "AssetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "groupKey": {
          "type": "integer"
        },
        "localKey": {
          "type": "string"
        },
        "parentField": {
          "type": "string"
        },
        "parameterIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "FieldChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "logicalAddress",
        "namespace",
        "id",
        "field",
        "semanticField",
        "before",
        "after",
        "source"
      ],
      "properties": {
        "operationId": {
          "type": "string"
        },
        "logicalAddress": {
          "$ref": "#/$defs/LogicalAddress"
        },
        "namespace": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "field": {
          "type": "string"
        },
        "semanticField": {
          "type": "string"
        },
        "semanticValue": true,
        "semanticUnit": {
          "type": "string"
        },
        "before": true,
        "after": true,
        "source": {
          "enum": ["ModelProposed", "UserEdited", "Default", "Compiler"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "LogicalAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableKey", "recordId", "field"],
      "properties": {
        "tableKey": {
          "type": "string",
          "minLength": 1
        },
        "recordId": {
          "type": "integer"
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
