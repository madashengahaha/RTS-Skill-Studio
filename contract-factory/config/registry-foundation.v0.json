  "nestedTypes": [
    {
      "key": "ValueSource",
      "label": "数值来源",
      "description": "逗号分隔的 PropId,Scale,Fix；结果=(Prop(PropId)×Scale+Fix)/10000。PropId 是 NumericType 属性编号，必须先按枚举值解析属性名和施法者属性值，不能把 PropId 本身当成结果。PropId=0 时只使用 Fix。",
      "encoding": {
        "kind": "Delimited",
        "separator": ",",
        "fields": ["PropId", "Scale", "Fix"]
      },
      "resolution": {
        "expression": "(owner.Property(PropId) × Scale + Fix) / 10000",
        "propIdZero": "PropId=0 时只使用 Fix。",
        "propIdNonZero": "PropId 是 NumericType 枚举编号，必须先解析对应施法者属性值；PropId 本身不是属性值。缺少运行实例时必须保留属性引用表达式，不能输出绝对数值。"
      },
      "fields": [
        {
          "key": "PropId",
          "label": "属性",
          "kind": "Enum",
          "enumName": "NumericType",
          "description": "NumericType 属性编号，0=None 表示只取固定值。"
        },
        {
          "key": "Scale",
          "label": "倍率",
          "kind": "ScaledInteger",
          "scale": 10000,
          "description": "按 10000 为 1.0 的万分比倍率。"
        },
        {
          "key": "Fix",
          "label": "固定值",
          "kind": "ScaledInteger",
          "scale": 10000,
          "description": "按 10000 为 1.0 的万分比固定值。"
        }
      ]
    }
  ],
  "fieldSemantics": [
    {
      "path": "Search.shape_param",
      "elementType": "ValueSource",
      "description": "按 shape 解释的数值来源列表。第 1 项是主范围或长度；第 2 项在扇形中为完整夹角，在矩形、十字、直线中为半宽，在环形中为厚度。",
      "indexRoles": [
        {
          "index": 0,
          "role": "rangeOrLength",
          "description": "主范围或长度；圆形、扇形、环形作为范围，矩形、十字、直线作为长度。该范围求值后会附加施法者 Radius。"
        },
        {
          "index": 1,
          "role": "shapeSecondary",
          "description": "扇形为完整夹角，运行时取该值的一半作为 HalfAngle；矩形、十字、直线为半宽；环形为厚度。"
        }
      ]
    }
  ],
